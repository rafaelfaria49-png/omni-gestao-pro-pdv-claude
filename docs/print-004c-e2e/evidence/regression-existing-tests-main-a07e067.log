+             {isSaving ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : <Check className="mr-2 h-4 w-4" />}
+             Salvar Atalhos
+           </Button>
+         </DialogFooter>
+       </DialogContent>
+     </Dialog>
+   )
+ }
