const btnGhost: React.CSSProperties = { minHeight: 34, padding: \"7px 14px\", border: `1px solid ${C.inputBd2}`, background: C.surface, color: C.body, borderRadius: 8, fontSize: 12, fontWeight: 500, cursor: \"pointer\" };
