      setLinhas(linhasImediatas.map((l: { forma: LinhaRecebimentoV4[\"forma\"]; valor: number }) => ({ forma: l.forma, valorStr: String(l.valor) })));
      setVencimento(\"\");
      setObservacao(imediata.observacao ?? \"\");
